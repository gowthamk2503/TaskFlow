# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or Atlas URI)
# Example local: mongodb://127.0.0.1:27017/taskflow
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/taskflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# JSON Web Token Secret (At least 32 characters)
JWT_SECRET=taskflow_super_secret_jwt_key_at_least_32_chars_2026

# Token expiration duration
JWT_EXPIRES_IN=7d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
